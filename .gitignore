# Secrets
.env

# sbt / build output
target/
project/target/
project/project/
.bsp/
logs/
*.log

# Play
airline-web/RUNNING_PID
airline-web/google-tokens/
airline-web/conf/google-oauth-credentials.json
airline-web/conf/gmail-credentials.json

# IDE
.idea/
.metals/
.bloop/
*.iml
.classpath
.project
.settings/

# Test dependencies
test/node_modules/
test/package-lock.json

# Our own output - backup-db.sh writes here.
backups/

# Windows shortcuts. Dragging a .bat to the Desktop leaves a .lnk behind in
# the folder, which used to trip the auto-updater's dirty-tree check.
*.lnk

# Written by scripts/write-version.sh on every update: which build is running.
# It must NOT be tracked. It was, and that deadlocked the updater on its own
# first success - the update rewrote the file, the next check saw a tracked
# file edited on the server, and refused to touch anything ever again.
airline-web/conf/version.json
