# Copy to .env and fill in. .env is gitignored - never commit real secrets.
#
#   cp .env.example .env && ${EDITOR:-nano} .env
#
# The scripts in scripts/ source this file and export the variables, which
# the Typesafe Config files pick up via ${?VAR} substitution.

# --- Database -----------------------------------------------------------
# Must match the docker-compose service (or your local MySQL/MariaDB).
AIRLINE_DB_HOST=localhost:3306
AIRLINE_DB_SCHEMA=airline_v2_1
AIRLINE_DB_USER=sa

# Generate with: openssl rand -base64 24 | tr -d '/+=' | head -c 24
AIRLINE_DB_PASSWORD=change-me

# Only used by docker-compose to bootstrap the MySQL container.
MYSQL_ROOT_PASSWORD=change-me-too

# --- Play application secret --------------------------------------------
# Signs session cookies. Anyone who knows it can forge logins, so set a real
# one before letting other people in.
# Generate with: openssl rand -base64 48
AIRLINE_APP_SECRET=change-me-as-well

# --- Google APIs (optional) ---------------------------------------------
# Without a map key the world map tiles will not render, but the rest of the
# game works. Set a billing budget/quota cap if you do use one - it is a paid
# API and overruns are charged.
#AIRLINE_GOOGLE_MAP_KEY=
#AIRLINE_GOOGLE_API_KEY=
