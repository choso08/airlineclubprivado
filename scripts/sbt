#!/usr/bin/env bash
# Thin sbt launcher using the sbt-launch.jar vendored in this repo, so sbt
# does not have to be installed and the version stays pinned by
# project/build.properties (1.9.9).
#
# Env knobs:
#   AIRLINE_SBT_HEAP        JVM max heap (default 6G). MainInit streams ~80MB
#                           of CSV and builds large in-memory maps.
#   AIRLINE_SBT_REPOS_FILE  Path to an sbt repositories file. When set, it is
#                           forced as the only resolver list. Use this on hosts
#                           whose egress policy blocks repo.scala-sbt.org /
#                           repo.typesafe.com; see conf/sbt-repositories.
#   AIRLINE_SBT_JVM_OPTS    Extra JVM flags, space separated. They go to the
#                           sbt JVM, which is the same JVM `run` uses, so this
#                           is how a program started through sbt gets its
#                           -D settings.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

JVM_ARGS=(
  -Xms512M
  -Xmx"${AIRLINE_SBT_HEAP:-6G}"
  -XX:ReservedCodeCacheSize=256m
  # A cycle allocates enormously and briefly: millions of small tuples for the
  # passenger groups and their routes, nearly all of them dead by the end of
  # the week. G1 is built for exactly that, and these three settings between
  # them keep the heap from creeping up to its ceiling and staying there -
  # which is what a JVM does by default, since collecting costs nothing until
  # the ceiling is near. A heap held at its limit spends its time collecting
  # rather than simulating, and the game looks stopped while the process is
  # perfectly alive.
  -XX:+UseG1GC
  # Give memory back to the machine instead of sitting on it: this box also
  # runs other things.
  -XX:G1PeriodicGCInterval=300000
  -XX:+G1PeriodicGCInvokesConcurrent
  # Identical strings - airport codes, model names, country codes - are held
  # once rather than once per object.
  -XX:+UseStringDeduplication
)

if [[ -n "${AIRLINE_SBT_REPOS_FILE:-}" ]]; then
  JVM_ARGS+=(
    -Dsbt.repository.config="$AIRLINE_SBT_REPOS_FILE"
    -Dsbt.override.build.repos=true
  )
fi

if [[ -n "${AIRLINE_SBT_JVM_OPTS:-}" ]]; then
  read -r -a EXTRA_JVM_ARGS <<< "$AIRLINE_SBT_JVM_OPTS"
  JVM_ARGS+=("${EXTRA_JVM_ARGS[@]}")
fi

exec java "${JVM_ARGS[@]}" -jar "$REPO_ROOT/sbt-launch.jar" "$@"
