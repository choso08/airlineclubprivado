# ============================================================================
#  GAME SETTINGS - the one file to edit when you want to change how the
#  game plays. Everything here is safe to commit; secrets live in .env.
#
#  After changing anything here:
#    - settings marked [restart]  ->  restart the simulation / web site
#    - settings marked [rebuild]  ->  ./scripts/build.sh, then restart
#    - settings marked [reinit]   ->  ./scripts/init-database.sh
#                                     (rebuilds the world; players, airlines
#                                      and money are NOT touched)
#
#  Take a backup first if you are changing anything you are unsure about:
#    ./scripts/backup-db.sh
# ============================================================================


# ----------------------------------------------------------------------------
#  PACE - how fast the game moves
# ----------------------------------------------------------------------------

# Real seconds per in-game week. [restart]
#
#   1800  = 30 min  upstream default. A game year takes ~26 real hours.
#            Good for a public server people visit once a day.
#    600  = 10 min  a game year in ~9 hours. Still relaxed.
#    300  =  5 min  a game year in ~4.5 hours. Good for an evening session
#                   where you want to actually see routes mature.
#    180  =  3 min  fast. A year in under 3 hours.
#    120  =  2 min  very fast - about the floor on a 2-core machine.
#
# Do not go below the time a cycle takes to compute, which the simulation
# prints every tick as "cycle N spent X secs". If cycles take longer than
# this interval they queue up and the game falls behind.
#
# Measured: on a 4-core machine a cycle takes 66-77 seconds. Most of that is
# the global passenger simulation over ~3800 airports, which barely changes
# with the number of players, so it will not grow much as friends join.
# On a 2-core i3-7100 expect roughly 2 to 2.5 minutes per cycle - which is
# why 300 (5 min) is the default here: about double the compute time, so
# there is headroom. Do not set 120 on that machine, cycles would overlap.
#
# Check yours:  journalctl -u airline-sim | grep "spent"
AIRLINE_CYCLE_SECONDS=300


# ----------------------------------------------------------------------------
#  SIGNUP AND ACCESS
# ----------------------------------------------------------------------------

# Google's anti-bot check on the signup form. [restart]
# Must stay false on a private instance: the built-in keys only work on
# airline-club.com, so with it on nobody can register.
AIRLINE_RECAPTCHA_ENABLED=false

# Port the web site listens on. [restart]
AIRLINE_WEB_PORT=9000

# Shortest password a player may choose, at signup and at password reset.
# [restart] Upstream demanded 6 at signup while allowing 4 on reset; both now
# read this. Fine for a private game among friends - raise it if you ever
# expose the site beyond your own network.
AIRLINE_MIN_PASSWORD_LENGTH=4


# ----------------------------------------------------------------------------
#  BACKUPS
# ----------------------------------------------------------------------------

# How many nightly backups to keep before the oldest is deleted.
AIRLINE_BACKUP_KEEP=14

# Where they go. Relative paths are relative to the repo.
#AIRLINE_BACKUP_DIR=backups


# ----------------------------------------------------------------------------
#  PERFORMANCE
# ----------------------------------------------------------------------------

# Memory ceiling for the build and for world generation. [restart]
# 6G is fine on a 16GB machine. Drop to 3G if the machine has 8GB.
AIRLINE_SBT_HEAP=6G


# ----------------------------------------------------------------------------
#  MONEY AND ECONOMY
# ----------------------------------------------------------------------------
#
# Not exposed as settings yet - these are still numbers hardcoded in the
# game's source. Ask and they get added here as proper settings:
#
#   Starting balance of a new airline
#     airline-web/app/controllers/SignUp.scala  (setBalance, currently
#     commented out, so new airlines start at 0)
#
#   Loan interest rates
#     airline-data/src/main/scala/com/patson/model/Bank.scala
#
#   Passenger demand levels
#     airline-data/src/main/scala/com/patson/DemandGenerator.scala
#
#   Fuel price swings
#     airline-data/src/main/scala/com/patson/OilSimulation.scala


# ----------------------------------------------------------------------------
#  FEATURES
# ----------------------------------------------------------------------------

# Opens what upstream reserves for Patreon donors: renaming your airline,
# custom wallpapers, and a third airline slot. [restart]
# There is nobody to donate to on a private instance, so the gates would only
# lock you out of your own game.
AIRLINE_ALL_FEATURES_UNLOCKED=true

# Map provider. "osm" needs no API key, no billing and no Google account.
# "google" is upstream's behaviour and needs AIRLINE_GOOGLE_MAP_KEY. [restart]
AIRLINE_MAP_PROVIDER=osm

# Seconds of warning players get before an update restarts the site. They see
# a countdown and the page reloads itself afterwards. 0 disables the warning.
AIRLINE_UPDATE_WARNING_SECONDS=30
