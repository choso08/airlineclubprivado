# ============================================================================
#  GAME SETTINGS
#
#  The one file to edit when you want to change how the game plays.
#  Safe to commit - no passwords live here; those are in .env.
#
#  After changing anything:
#
#    ./scripts/update.sh --no-pull      applies it, warns players, and their
#                                       pages reload themselves
#
#  Or by hand:  sudo systemctl restart airline-web airline-sim
#
#  Anything marked [both] is read by BOTH halves of the game, so the
#  simulation has to be restarted too, not just the web site.
#
#  Take a backup before anything you are unsure about:
#    ./scripts/backup-db.sh
# ============================================================================


# ============================================================================
#  MONEY
# ============================================================================

# What a new airline starts with. [restart]
#
# The player picks one of three startup profiles when they choose a home
# airport; this is the base all three derive from, so changing it scales them
# together and keeps them balanced against each other.
#
# Measured at Beja, the three profiles offer:
#     40000000  (40M, upstream)  ->  132M / 136M / 375M
#    250000000  (250M)           ->  342M / 262M / 767M
AIRLINE_STARTING_CAPITAL=40000000

# Extra starting capital per point of home-airport difficulty, so picking a
# hard airport is not a pure penalty. Upstream: 1000000. [restart]
AIRLINE_DIFFICULTY_BONUS=1000000

# Yearly bank interest rate. The simulation drifts it up and down over time
# within a band derived from this, so it sets the general cost of borrowing.
# Upstream: 0.12 (12%). Try 0.05 for a friendlier game. [both]
AIRLINE_LOAN_INTEREST_RATE=0.12

# Largest single loan, and how many an airline may hold at once. [both]
AIRLINE_MAX_LOAN_AMOUNT=500000000
AIRLINE_MAX_LOANS=10

# Fuel price the market drifts around, per unit. This is the biggest lever on
# whether airlines are profitable: raise it to squeeze margins, lower it to
# make long routes cheap. Upstream: 70. [both]
AIRLINE_FUEL_PRICE=70

# Cost of bases: building and upgrading them, and the weekly upkeep. [both]
#
# Percentages of the original price. 50 is half, 100 is as the game ships.
#
# Both scale a curve that multiplies by 1.7 for every level, so the top levels
# are where the money really is: at level 10 a base costs about 40 times what
# it costs at level 3. Halving them is the difference between a second base
# being a project and being out of reach on a server where nobody is grinding
# for hours a day.
AIRLINE_BASE_COST_PERCENT=50
AIRLINE_BASE_UPKEEP_PERCENT=50

# Three mechanics the game has that five people never get to switch on, because
# the prices and the requirements were written for thousands of players. [both]

# Base specialisations - giving a base a vocation (negotiation, cargo,
# passengers). Upstream demands level 8 to 14; at 50% that becomes 4 to 7,
# which is a serious base but a reachable one.
AIRLINE_BASE_SPECIALIZATION_SCALE_PERCENT=50

# Airport assets - hotels, shopping centres, car parks that earn week after
# week. Upstream charges 200 to 2000 million. At 25% they land between 50 and
# 500, which is expensive without being impossible.
AIRLINE_AIRPORT_ASSET_COST_PERCENT=25

# VIP lounges. Upstream charges 50 million a level, up to level 3. At 40% that
# is 20 million a level.
AIRLINE_LOUNGE_COST_PERCENT=40

# How many routes fit in a base before you start paying overtime. [both]
#
# This is what really limits you. Every route needs staff at the airport it
# departs from; a headquarters carries 60 + 80 a level, the other bases 60 a
# level. Going past that is charged every week, for ever. It is why the middle
# of the game comes down to "I need a bigger headquarters before I open
# anything else".
#
# 200 means every level carries twice the routes. The idea that a bigger
# headquarters carries more is still there - it just stops being the only thing
# that matters.
AIRLINE_OFFICE_STAFF_CAPACITY_PERCENT=200

# What going past that capacity costs. 0 removes the penalty completely - and
# with it any reason to upgrade the headquarters.
AIRLINE_OFFICE_OVERTIME_PERCENT=100


# ============================================================================
#  CEILING ON WHAT WAS ADDED
# ============================================================================

# The most that anything added in this fork may move demand or costs, in
# percent - however many of them land in the same week. [both]
#
# Seasons, world events and incidents are there to give a week some character,
# not to decide it. A summer that doubles a route and a winter that empties it
# is not a season, it is a raffle - and two of them landing in the same week
# would be worse still.
#
# So everything is multiplied together and then held inside this band. At 30,
# the worst week this fork can produce is worth 0.7 of a normal week, and the
# best 1.3. No combination gets past that.
AIRLINE_MAX_ADDED_SWING=30


# ============================================================================
#  PACE - how fast the game moves
# ============================================================================

# Real seconds per in-game week. [both]
#
#   1800  = 30 min  upstream. A game year takes ~26 real hours.
#    600  = 10 min  a game year in ~9 hours.
#    420  =  7 min  a game year in ~6 hours.
#    300  =  5 min  a game year in ~4.5 hours.
#    180  =  3 min  a game year in ~2.6 hours. Currently set.
#    120  =  2 min  a game year in ~1.7 hours.
#
# Never set this below the time a cycle takes to compute, or cycles queue up
# behind each other and the game falls behind. Measured on the i3-7100 this
# runs on: 41 to 66 seconds a cycle. At 180 that is roughly a quarter to a
# third of the interval spent computing, which leaves room for a cycle that
# runs long - and cycles do get slower as the world grows. Check it now and
# then:
#
#   journalctl -u airline-sim | grep spent | tail
#
# If that number creeps past about 90, put this back up.
#
# Check yours:  journalctl -u airline-sim | grep spent
#
# The web site reads this too, so the on-screen clock ticks at the right
# speed from the moment the page loads. And the aircraft on the map fly to it:
# one cycle is one week of flying, so halving this doubles their speed.
#
# Careful: .env wins over this file. If AIRLINE_CYCLE_SECONDS is also set
# there, that is the one being used.  grep CYCLE .env
AIRLINE_CYCLE_SECONDS=180

# Holiday mode: slowing down when nobody is playing. [both]
#
# The server runs all week for people who play on some evenings. Left alone it
# advances a week every few minutes regardless, so a friend who misses two days
# comes back to a world that moved months without them - which is how a game
# between five people quietly becomes a game between whoever logged in most.
#
# "true" makes the simulation rest while nobody is around. It still wakes on
# schedule, but only plays out one week in AIRLINE_HOLIDAY_SLOWDOWN. The moment
# anybody logs in it is back to full speed on the very next week, and the Force
# week button always works regardless.
AIRLINE_HOLIDAY_MODE=false

# How long with nobody playing before it starts resting.
AIRLINE_HOLIDAY_IDLE_MINUTES=30

# How much slower while resting. 4 means one week in four - so at 7 minute
# cycles, a week every 28 minutes instead of every 7.
AIRLINE_HOLIDAY_SLOWDOWN=4


# How long a week lasts AT NIGHT, in seconds, and which hours count as night.
# 0 keeps the same pace all day round. [both]
#
# The server runs all night for people who are asleep. At 3 minutes a week that
# is 160 weeks between going to bed and waking up - three years of a world
# nobody saw. Slowing the night down is the difference between coming back to
# your own airline and coming back to a stranger's.
#
# Set to 5 minutes from midnight to 10:00, and 3 minutes the rest of the day.
# The hours are read from the clock of the machine the game runs on.
#
# Do not make the night more than twice the day: the clock on the site does not
# believe in weeks more than twice as long as the configured one, and it would
# start running too fast.
AIRLINE_NIGHT_CYCLE_SECONDS=300
AIRLINE_NIGHT_FROM_HOUR=0
AIRLINE_NIGHT_TO_HOUR=10


# ============================================================================
#  LEASING AND INSTALMENTS
# ============================================================================

# Lets you have aircraft without paying for them all at once. [both]
#
# Buying was the only way to have an aircraft, and an aircraft costs more than
# anything else in the game. So the first hour is nothing but waiting for money,
# a route that goes badly is paid for twice (on the route, and on selling the
# aircraft at a loss), and a route that is only worth it in summer is not worth
# it at all, because the aircraft is yours in winter too.
#
# Switched on, two buttons appear next to Buy:
#
#   LEASE        small deposit, small weekly payment, for ever, and the
#                aircraft is never yours. You hand it back the week you stop
#                needing it.
#   INSTALMENTS  bigger deposit, bigger weekly payment, for a fixed number of
#                weeks - and when you pay the last one the aircraft is yours.
#
# A leased aircraft arrives RIGHT AWAY: it is somebody else's aircraft, already
# built, and having it today is half the reason to lease. On instalments it is a
# new aircraft bought on credit, so it takes the model's usual weeks to be
# built, exactly like a purchase - otherwise instalments would simply be better
# than buying. Until it is paid off it cannot be sold, given away in a deal, or
# counted as assets - it is not yours.
AIRLINE_AIRCRAFT_FINANCING=true

# Lease: a year of rent as a percentage of the aircraft's price.
# At 18, an aircraft of 100 million comes to ~346,000 a week.
AIRLINE_LEASE_ANNUAL_RATE=18

# Lease: the deposit, as a percentage of the price. You do not get it back.
AIRLINE_LEASE_DEPOSIT=10

# Instalments: the deposit, as a percentage of the price.
AIRLINE_INSTALMENT_DEPOSIT=25

# Instalments: how many weeks of payments. 104 is two game years.
AIRLINE_INSTALMENT_WEEKS=104

# Instalments: how many points BELOW the bank's interest rate the instalment
# rate sits.
#
# The rate follows the bank instead of having a number of its own, because it is
# the same market - and it sits below because this is a loan against the
# aircraft itself: stop paying and the aircraft goes back. The bank has no such
# security and charges for it. With the bank at 12%, instalments come to 9%.
#
# The rate is fixed the moment you sign: the weekly payment is written into the
# plan and never changes again. What moves is the rate you are offered next
# time, not the one you have already taken.
AIRLINE_INSTALMENT_BELOW_BANK=3


# ============================================================================
#  PRICES AND DEMAND
# ============================================================================

# How different passengers are from one another in the price they will accept,
# in percent. 0 goes back to the old behaviour. [both]
#
# Every passenger has a price above which they simply do not fly, and that limit
# was EXACTLY THE SAME for all of them. So there was a wall: at around 1.25x the
# suggested price the aircraft went half full, and at 1.3x it went empty. Raising
# the price a little further did not cost you some passengers, it cost you all of
# them.
#
# With this on, each group of passengers has its own limit, some higher and some
# lower (the average stays where it was, so the world does not suddenly get
# richer). Measured, at 40, how many accept the flight:
#
#                          before      now
#   suggested price          35%        45%
#   1.1x suggested           16%        27%
#   1.2x suggested            4%        13%
#   1.3x suggested            0%         4%
#   1.5x suggested            0%         0.2%
#
# In other words: demand now falls away gradually instead of off a cliff, and
# charging a lot becomes a choice (fewer people, more per ticket) instead of a
# mistake. 80 spreads them much further, 0 switches it off.
#
# Charging too much is not free even when they do fly: satisfaction at that
# price is already zero, so loyalty at that airport falls week after week.
AIRLINE_PRICE_ELASTICITY=30


# ============================================================================
#  TAX
# ============================================================================

# The country a route departs from taxes the profit on it. [both]
#
# The game has countries with an income and a name, and asks an airline nothing
# for being there. So one airport is as good as another once the passengers are
# counted, and where you put your bases is only a question of demand.
#
# With tax it becomes a question of country as well. The rate follows the
# country's income - the only measure of a country the game keeps: the rich ones
# charge more, and flying out of a poorer one leaves you more than the route
# earns.
#
# A route is taxed where it DEPARTS - and that is always a base of yours,
# because a route cannot start anywhere else. It is route by route, and only on
# profit: a route that loses money pays nothing, and cannot be set against
# another route's profit.
#
# Each country's rate shows up in the airport panel, under the market openness.
#
# What is charged appears in the accounts on the asset expense line, together
# with the aircraft payments and the freight - the income statement's columns
# are fixed in the database, and adding a new one would mean altering the table
# of a world that already exists.
AIRLINE_TAX=true

# What an average country charges, as a percentage of the route's profit.
AIRLINE_TAX_BASE=15

# How far the rate moves up or down with the country's income.
# At 8 on a base of 15: the poorest charge 7%, the richest 23%.
AIRLINE_TAX_SPREAD=8

# VAT on aircraft, in percent, reclaimed against the tax. 0 switches it off.
#
# A company in Europe pays VAT on an aircraft and then gets it back, against
# what it owes on its profits. It is why a company that has just invested spends
# a while paying no tax - and it is what makes buying an aircraft a decision
# about the tax bill too, not only about the cash in hand.
#
# It applies to the price of an aircraft bought outright, to the deposit on a
# lease or on a set of instalments, and to EACH weekly payment - just like the
# VAT on a lease rental.
#
# How it works: the purchase creates a credit (23% of the price). Every week the
# route tax is paid out of that credit first, until it runs out. An aircraft of
# 50 million gives 11.5 million of credit - which, with tax at 8% in Portugal,
# is many weeks of paying nothing.
#
# A notice goes in the log when the purchase is made and another when the credit
# runs out - from then on the tax is real again.
AIRLINE_VAT=23


# ============================================================================
#  REGIONAL SUBSIDIES
# ============================================================================

# The state helps out small routes that run at a loss. [both]
#
# In the game every route has to pay for itself, so the only routes worth flying
# are the ones that already have passengers - and small airports stay empty for
# ever. Anywhere with public service obligations it is the other way round: the
# state pays for the connection to exist.
#
# A route between TWO small airports, short, and losing money, gets back half of
# that week's loss - up to a ceiling.
#
# It never makes a route profitable on its own: it covers part of a loss, and a
# route that turns a profit gets nothing. That is deliberate - the idea is to
# make flying into the countryside possible, not to turn it into a better
# business than flying to the capitals.
AIRLINE_SUBSIDY=true

# Up to what airport size counts as small (airports run from 1 to 9; 3 is a
# regional airport).
AIRLINE_SUBSIDY_MAX_AIRPORT_SIZE=3

# Up to how many km. Further than this is no longer a public service link.
AIRLINE_SUBSIDY_MAX_DISTANCE=1500

# What percentage of the week's loss is covered, and the most per route per
# week.
AIRLINE_SUBSIDY_LOSS_PERCENT=50
AIRLINE_SUBSIDY_CAP=500000


# ============================================================================
#  FREIGHT
# ============================================================================

# Freight contracts. [both]
#
# An aircraft's hold flies empty every week of its life, and the only thing an
# airline can sell is a seat. Freight added as "your routes now earn a little
# extra as well" would be money appearing with no decision behind it - the least
# interesting thing you can add to a game.
#
# So it comes as CONTRACTS. Somebody offers so many tonnes a week between two
# airports, for so many weeks, at a price. Accepting is a promise of hold space
# on a route you now have to keep flying - and being paid every week, whatever
# happens to the passengers.
#
# The hold is real: the capacity comes from the aircraft actually on the route
# that week (0.02 tonnes per seat per flight). A 180-seat aircraft flying 14
# times carries 50 tonnes a week.
#
# The offers only show up on routes you already fly. If there is no space in a
# given week you lose that week's payment; the third missed week cancels the
# contract. Backing out of your own accord costs 4 weeks.
AIRLINE_CARGO=true

# What a tonne per kilometre is worth.
# At 2, 20 tonnes on a 1000 km route are worth 40,000 a week.
AIRLINE_CARGO_RATE=2.0

# The chance of a new offer appearing, per airline per week, and how many may
# sit on the table unanswered.
AIRLINE_CARGO_OFFER_CHANCE=25
AIRLINE_CARGO_MAX_OFFERS=3

# How many weeks a contract lasts.
AIRLINE_CARGO_MIN_WEEKS=8
AIRLINE_CARGO_MAX_WEEKS=26


# ============================================================================
#  INCIDENTS
# ============================================================================

# Things that go wrong for ONE airline at a time. [both]
#
# World events give everybody something to react to at the same time. What they
# cannot do is catch one person in particular - and a game between five people
# needs that too: a week where one of you is in trouble and the other four see
# it, take advantage of it, or help out.
#
# It is not luck falling on whoever it falls on. The odds come from the STATE OF
# THE FLEET: with new aircraft it is a third of this, with worn-out aircraft it
# is double. Which makes maintenance a decision instead of a bill.
#
# Three things can happen:
#
#   BREAKDOWN (half the time)  one of your aircraft - the worst of them - breaks
#                              down. You pay for the repair and it loses
#                              condition. That week only.
#   INSPECTION (35%)           delays on all of your flights for a few weeks.
#   STRIKE (15%)               cancelled flights for a few weeks.
#
# The delays and cancellations use the machinery the game already has: they
# already pay compensation, already disappoint passengers, and already show up
# on the flight card.
#
# Everybody is told when one starts - half the fun is the others seeing it. It
# only catches real airlines; news about computer airlines is not news.
AIRLINE_INCIDENTS=true

# The chance per airline per week, in percent, with an average fleet. At 2, with
# 5 people and 3 minute cycles, that is roughly one incident somewhere every
# half hour. Drop it to 1 if it is too much.
AIRLINE_INCIDENT_CHANCE=2

# How many weeks a strike or an inspection lasts.
AIRLINE_INCIDENT_MIN_WEEKS=2
AIRLINE_INCIDENT_MAX_WEEKS=5

# How hard it hits, in percent: how many times more likely the delays become,
# and how much of the aircraft's value a repair costs.
AIRLINE_INCIDENT_MIN_STRENGTH=50
AIRLINE_INCIDENT_MAX_STRENGTH=100


# ============================================================================
#  SEASONS
# ============================================================================

# How much the month of the year moves demand, in percent. 0 switches it off.
# [both]
#
# The game has a calendar and ignores it completely: demand in January is the
# same as in August, so a route to the Algarve is worth the same in the rain as
# in the sun, and choosing routes is a decision taken once and never revisited.
#
# With seasons on it becomes a decision about the weather. Holidays follow the
# summer - which is a different month in each hemisphere - and business travel
# drops when the offices empty out, at Christmas and in August.
#
# At 30, measured:
#
#   London->Faro (holiday)     0.75 in January, 1.26 at the end of July
#   London->Sydney (holiday)   1.05 in January, 0.95 in July - the other way
#   London->Lisbon (business)  1.00 nearly always, 0.82 at Christmas, 0.87 in
#                              August
#
# A beach route now earns twice as much in summer as in winter. If that is too
# much, drop it to 15.
AIRLINE_SEASON_STRENGTH=30


# ============================================================================
#  WORLD EVENTS
# ============================================================================

# Whether something happens to the world every now and then. [both]
#
# The game has an event system and uses it for one thing only: the Olympics,
# every four game years. Between them nothing ever happens that anybody has to
# react to - the world in week 300 is the same as in week 3, and the only news
# is what you did to each other.
#
# With this on, every so often there appears:
#
#   Fuel crisis            everybody pays more, no exceptions
#   Tourism boom           a country everybody wants to visit
#   Recession              a country that has stopped travelling
#   Trouble at an airport  a strike, bad weather, a closed runway
#
# One at a time, a few weeks each, announced in every airline's log. It only
# moves demand and fuel - nothing here changes any rules.
AIRLINE_WORLD_EVENTS=true

# Roughly how many weeks between one and the next. At 25, with 3 minute cycles,
# that is about one every hour and a half of play.
AIRLINE_WORLD_EVENT_EVERY_WEEKS=25

# How long it lasts, in weeks.
AIRLINE_WORLD_EVENT_MIN_WEEKS=4
AIRLINE_WORLD_EVENT_MAX_WEEKS=10

# How hard it hits, in percent.
AIRLINE_WORLD_EVENT_MIN_STRENGTH=10
AIRLINE_WORLD_EVENT_MAX_STRENGTH=30

# How fast the in-game clock and calendar run. [restart]
#
# 1 means one cycle is one week on the clock, which is what the game has always
# done: at seven minute cycles the date advances a day every real minute.
#
# This does NOT change the simulation. A cycle is still a week of flying and
# still pays a week's money - only the clock on the page moves differently, and
# the aircraft on the map with it, since they are drawn against that clock.
#
#   1      the original pace.
#   0.5    half speed. A game week takes two cycles, the date advances half as
#          fast, and flights take twice as long to cross the map.
#
# Note this multiplies with AIRLINE_MAP_FLIGHT_SPEED further down: at 0.5 here
# and 0.5 there, an aircraft crosses at a quarter of the original speed.
AIRLINE_GAME_TIME_SPEED=0.5

# Which year the in-game calendar starts from. [restart]
#
# Cycle 0 is 1 January of this year and each cycle is one week, so a brand new
# world starts here and the date advances a week per cycle. Upstream never set
# this, which is why an untouched world reads as 1970.
#
# Purely cosmetic - nothing in the simulation looks at the date - and safe to
# change at any time, including mid-game. The displayed date will jump.
AIRLINE_GAME_START_YEAR=2026

# To move the clock itself - jump forward a year, wind back a month - use:
#
#   ./scripts/game-time.sh              see where the game is
#   ./scripts/game-time.sh --add 52     jump forward a year
#   ./scripts/game-time.sh --remove 4   wind back a month
#
# Note that jumping does NOT play those weeks out: the date moves, but no
# passengers fly and no money is earned. To make the game genuinely progress
# faster, lower AIRLINE_CYCLE_SECONDS above instead.


# The welcome panel players see on login lives in
# airline-web/public/html/announcement.html - plain HTML, edit it freely.
# Upstream's version announced their releases and pointed at their Discord and
# Patreon; it has been replaced with house rules you can rewrite.


# ============================================================================
#  PLAYERS AND ACCESS
# ============================================================================

# Opens what upstream reserves for Patreon donors: renaming your airline,
# custom wallpapers, and a third airline slot. [both]
AIRLINE_ALL_FEATURES_UNLOCKED=true

# Google's anti-bot check on the signup form. [restart]
# Keep this false: the keys built into the game only work on airline-club.com,
# so turning it on stops anyone here from registering at all.
AIRLINE_RECAPTCHA_ENABLED=false

# Shortest password a player may choose. [restart]
# Fine at 4 behind Tailscale, where only invited people can reach the site at
# all. Raise it to 8 if you ever expose the game more widely.
AIRLINE_MIN_PASSWORD_LENGTH=4

# Days a player must wait between renaming their airline. [restart]
# Upstream enforces 30. That is a rule for a public server, where a name is an
# identity other players are owed some consistency in; among friends it is just
# an obstacle. 0 means rename as often as you like.
AIRLINE_RENAME_COOLDOWN_DAYS=0

# Reputation needed before someone may upload their own airline logo or livery.
# Upstream requires 40 - a brake on a public server, where anyone can register
# and start posting images. Among friends it only means nobody gets to
# decorate their airline for the first several hours. 0 removes it. [both]
AIRLINE_BRANDING_MIN_REPUTATION=0

# Weeks a delegate stays tied up after negotiating a route, before you can send
# it somewhere else. Upstream: 12 - an hour of real waiting per delegate per
# route at five minute cycles. At 3 it is a quarter of an hour. [both]
#
# Note this is recorded when a delegate is released, not read when you look at
# the panel: delegates already waiting keep whatever was in force when their
# task ended, and only the ones freed after the change get the new figure.
AIRLINE_DELEGATE_COOLDOWN_CYCLES=3

# Weeks before you may negotiate the same route again. [both]
# Upstream: 6 - half an hour of real waiting at five minute cycles, on a route
# you may only have wanted to adjust. Note this is stamped on the route when
# the negotiation ends: routes already waiting keep the old figure, and only
# ones negotiated after the change get the new one.
AIRLINE_NEGOTIATION_COOLDOWN_CYCLES=2

# Buying a route instead of negotiating for it. [both]
#
# The original game makes you send delegates to negotiate a route, rolls dice
# on whether they succeed, ties those delegates up for weeks, and bars the
# route for weeks more if they fail. Among friends the waiting is the only part
# anybody feels.
#
# "true" removes all of it. No dice, no waiting - the difficulty becomes a
# price instead, charged on top of the usual cost of opening a route. A hard
# route is still a hard route, in money rather than in weeks, and the dialog
# tells you what it will cost before you agree.
#
# Delegates are not left with nothing to do - see the two settings below.
AIRLINE_BUY_ROUTES=true

# What one point of negotiation difficulty costs, with the above on.
#
# 0 means a route costs exactly what it always cost to open - the difficulty is
# still worked out and still shown in the dialog, but it is only a remark now.
# Raise it if opening routes starts to feel too easy: at 2000000 a typical
# short domestic route costs about 7M on top.
AIRLINE_NEGOTIATION_FEE_PER_POINT=0

# What each delegate takes off the price of opening a route. [restart]
#
# With routes bought rather than negotiated there is no negotiation left for
# delegates to win, so this is what they do instead: send them along and the
# route costs less. They stay busy for AIRLINE_DELEGATE_COOLDOWN_CYCLES weeks
# afterwards, so each route is a decision about where the pool goes and not a
# button that is always worth pressing.
#
# 0 switches it off, the panel disappears, and delegates go back to being
# decoration - which is what they were before this existed.
AIRLINE_DELEGATE_DISCOUNT_PERCENT=10

# The most all the delegates together can take off one route. Without a
# ceiling, a big enough pool would make routes free.
AIRLINE_MAX_DELEGATE_DISCOUNT_PERCENT=50

# Whether a faster aircraft is actually faster on short routes. [both]
#
# The original game caps the first 300 km of any flight at 350 km/h, the next
# 400 at 500, the next 400 at 700, and only then uses the aircraft's own speed.
# The idea is right - a short flight is mostly climbing and descending - but
# the caps are fixed numbers, so under about 700 km EVERY aircraft above
# 700 km/h takes exactly the same time:
#
#                        500 km        with this on
#   Bombardier DHC-8-400  75 min          79 min      (turboprop, 667 km/h)
#   Bombardier CRJ1000    75 min          60 min      (jet, 870 km/h)
#
# So a jet was worth nothing on the routes most people fly, and on the map it
# moved exactly like a turboprop. "true" makes each cap the same fraction of
# the aircraft's own speed. An aircraft cruising at 700 km/h is unchanged.
#
# Note: routes already created keep the duration they were given. Only routes
# created or edited after the change get the new figure.
AIRLINE_PROPORTIONAL_CLIMB=true

# The biggest discount an aircraft can get for being unpopular, in percent.
# [both]
#
# This is the one behind "I bought a plane and the game says I made 38 million".
# The original game discounts a model as the number of them flying in the world
# falls short of a threshold - 300 of a small aircraft, 1000 of a medium one -
# down to 70% off. That is written for a server with thousands of players. Five
# friends will never own three hundred of anything, so every model in the game
# sits permanently at almost the full 70% off, and aircraft cost a quarter of
# their list price.
#
# It also makes the income statement nonsense: the game puts an aircraft on the
# books at list price and counts the discount as a capital gain, so buying one
# plane at 77% off shows up as tens of millions of profit in a week you in fact
# spent money.
#
#   70  the original. Everything is nearly free here.
#   10  a small discount that still rewards flying something unusual.
#    0  no discount at all; every aircraft costs what it says.
#
# Takes effect on the next cycle after a restart - the discounts are worked out
# fresh each week.
AIRLINE_MAX_MODEL_DISCOUNT_PERCENT=20

# Airlines needed before an alliance is established rather than just "forming".
# Only an established alliance gets code-sharing and the alliance bonuses.
# Upstream: 3, which on a server of five people is half of everyone. [both]
AIRLINE_ALLIANCE_MIN_MEMBERS=2

# Whether applying to an alliance joins it there and then. [both]
# The original game makes every application wait for the leader to accept it.
# That needs somebody logged in and looking at the alliance panel at the right
# moment - and in an alliance that has lost its leader, nobody can ever accept
# anything, so applications sit there for ever with nothing to say why.
# "true" for a private game with friends; "false" is the original behaviour.
AIRLINE_ALLIANCE_AUTO_ACCEPT=true

# How much faster delegates gain their levels. Upstream levels them up after
# 4 weeks, then a year, then three years, then ten - and ten in-game years at
# five minute cycles is forty-three hours of real time, which nobody here will
# ever reach. 4 divides all four, so the top level lands around eleven hours.
# Set 1 for upstream's pace. [both]
AIRLINE_DELEGATE_LEVEL_SPEED=4

# Which language the interface opens in for someone who has never chosen one.
# "en" is the game's own and the only complete one. "pt" translates the
# interface - menus, tables, buttons, dialogs - and leaves airport, city and
# aircraft names in the original, since those are proper nouns. Each player can
# change it for themselves under Settings. [restart]
AIRLINE_LANGUAGE=en

# Port the web site listens on. [restart]
AIRLINE_WEB_PORT=9000


# ============================================================================
#  MAP
# ============================================================================

# "osm"    - OpenStreetMap. No API key, no billing, no Google account.
# "google" - upstream's map; needs AIRLINE_GOOGLE_MAP_KEY and a Google Cloud
#            billing account. The heatmap screen only works on this one.
# [restart]
AIRLINE_MAP_PROVIDER=osm

# Where the map opens when someone loads the game. [restart]
# Upstream centres on the Pacific (20, 150.644), which is half a world of
# dragging away from a European airline. This points it at Iberia.
AIRLINE_MAP_DEFAULT_LAT=39.5
AIRLINE_MAP_DEFAULT_LNG=-8.0
AIRLINE_MAP_DEFAULT_ZOOM=5

# How the map picks between its light and dark tiles. [restart]
#
#   follow - matches the game's own Color Theme, under Settings. One switch
#            for everything, which is what people expect. The switch at the
#            bottom right of the map does the same thing.
#   dark   - always dark, whatever the rest of the game is set to
#   light  - always light
AIRLINE_MAP_THEME=follow

# How fast the aircraft cross the map, as a fraction of real speed. [restart]
# One cycle is one week of flying, so at seven minute cycles a short leg crosses
# in a couple of seconds - accurate, and impossible to click on. At 0.5 they
# move at half that and stay in the air twice as long, which makes them
# catchable. They still leave at exactly the scheduled time; only the arrival
# runs late, and the card you get on clicking still quotes the real timetable.
AIRLINE_MAP_FLIGHT_SPEED=0.5

# The most aircraft drawn on any one route. [restart]
#
# A route flown two hundred times a week cannot be drawn two hundred times: it
# turns into a smudge, and it is twenty position calculations a second for each
# of them. Above this the departures kept are spread across the week, so the
# route still moves at its own pace, just with fewer aircraft showing it.
#
# The aircraft fly slightly to the RIGHT of the line, as they do in real air
# traffic, so the two directions pass alongside each other instead of one on top
# of the other.
AIRLINE_MAP_MAX_FLIGHTS=4

# What language the map labels the world in. [restart]
#
#   local   - each country in its own language, as OpenStreetMap draws it:
#             Deutschland, Ellada in Greek letters, Arabic across North Africa.
#             Faithful, and hard to read across a continent you cannot spell.
#   english - Esri's world street map, labelled in English almost everywhere.
#             One palette only, so dark mode is made by inverting the tiles in
#             your browser - which still leaves the routes and aircraft their
#             real colours, since only the map layer is inverted.
#
# Names are drawn into the tile images, so this is decided by whoever draws the
# tiles - the game cannot translate them afterwards.
#
# If the map ever comes up blank with the markers still on it, the tile server
# is refusing the requests: put this back to "local" and it returns at once.
# Wikimedia's international style was tried here and is NOT usable - they serve
# it only to their own sites and refuse everyone else, which shows up as
# exactly that blank map.
AIRLINE_MAP_LABELS=local

# Where map tiles come from, when using osm. There are two - the light theme
# and the dark theme - and by default both come from CARTO, which is the same
# cartography in two palettes and needs no account. [restart]
#AIRLINE_MAP_TILE_URL_LIGHT=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
#AIRLINE_MAP_TILE_URL_DARK=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
#
# A note on the language of the labels. Map tiles carry their names baked into
# the image, so this is decided by whoever draws the tiles, not by the game.
# Plain OpenStreetMap uses each country's own language - Deutschland, Ellada in
# Greek letters, Arabic across North Africa - which is faithful and, on a world
# map you are trying to plan routes across, hard to read.
#
# Wikimedia draw an "international" style that prefers the English name where
# one exists. It has no dark twin, so setting it means one palette for both
# themes:
#AIRLINE_MAP_TILE_URL=https://maps.wikimedia.org/osm-intl/{z}/{x}/{y}.png
#
# It is Wikimedia's service and meant for their own projects; fine for five
# people, not something to point a public server at.

# Setting THIS one instead overrides both themes at once - for pointing at your
# own tile server. Careful: it also turns the light/dark switch into a no-op,
# because both themes then draw the same tiles. Plain OpenStreetMap has no dark
# equivalent, which is why it is not the default here.
#AIRLINE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Only needed if you switch the provider to "google".
#AIRLINE_GOOGLE_MAP_KEY=

# Real weather on the airport departure boards, from OpenWeatherMap. [restart]
# Upstream hard-coded its own key into the source; being in a public repository
# it is shared by every copy of the game and gets rate-limited. Free keys are
# at openweathermap.org. "off" stops asking altogether - the boards then show
# no weather, and nothing is ever delayed by it.
#AIRLINE_WEATHER_API_KEY=off

# Photos of cities and airports, shown in the route dialogs. [restart]
#
#   wikipedia - Wikipedia's geosearch, by coordinates. No key, no account, no
#               billing. Looks up by position rather than name, since names are
#               ambiguous and the game knows exactly where each airport is.
#   google    - upstream behaviour; needs AIRLINE_GOOGLE_API_KEY below on a
#               billing-enabled Google Cloud project.
#   none      - no photos; the game shows its own placeholder.
AIRLINE_IMAGE_PROVIDER=wikipedia

# Which Wikipedia to ask. "en" has by far the most articles with photographs.
AIRLINE_WIKIPEDIA_LANGUAGE=en

# Only needed with AIRLINE_IMAGE_PROVIDER=google.
#AIRLINE_GOOGLE_API_KEY=

# Decorative video clips during route negotiation. [restart]
# Off, because they are hosted on the upstream author's Vimeo account and
# browsers with tracking protection (Firefox by default) refuse to load them,
# leaving a "this video cannot be played here" panel mid-dialog.
AIRLINE_NEGOTIATION_CLIPS=false

# Upstream's promotional video on the front page. [restart]
# Off, because it autoplays and the Vimeo player then talks to four of their
# domains on every single visit - heartbeats, session beacons, player
# statistics - to advertise a game you are already running.
AIRLINE_LANDING_VIDEO=false


# ============================================================================
#  UPDATES
# ============================================================================

# Seconds of warning players get before an update restarts the site. They see
# a countdown, and their pages reload themselves once it is back. 0 disables
# the warning entirely.
AIRLINE_UPDATE_WARNING_SECONDS=30

# How often the game looks for a new version, in minutes.
#
# A check that finds nothing costs one `git fetch` and disturbs nobody, so
# there is no reason for this to be long: the compiling, the backup and the
# restart only happen when there is actually something new to install.
#
# Changing this needs the timer rewritten, which the ordinary update does not
# do - run it once by hand afterwards:
#
#   ./scripts/install-services.sh
#
# Check what is installed with:  systemctl list-timers 'airline-*'
AIRLINE_UPDATE_INTERVAL_MINUTES=5

# Whether the 10-minute timer may apply updates on its own. Set to "off" to
# pause it without touching your crontab.
AIRLINE_AUTO_UPDATE=on


# ============================================================================
#  BACKUPS
# ============================================================================

# Lets an admin take a backup from the page, with a button next to the clock.
# [restart]
#
# Empty means off, and off is the default on purpose: this names a program the
# web site is allowed to run, and a web site that will run things is how one
# break-in turns into all of them. Nothing typed into the page ever reaches the
# command line - only this exact path is run, with no arguments, and only for
# an admin account. Set it to the full path if you want the button:
#
# Leave this alone and the Backup button in the top bar just works: the server
# falls back to this instance's own scripts/backup-db.sh. Only set it if your
# backup lives somewhere else.
#AIRLINE_BACKUP_SCRIPT=/home/you/airline/scripts/backup-db.sh

# How many nightly backups to keep before the oldest is deleted.
AIRLINE_BACKUP_KEEP=14

# Where they go. Relative paths are relative to the repo.
#AIRLINE_BACKUP_DIR=backups


# ============================================================================
#  PERFORMANCE
# ============================================================================

# Java's memory ceiling, for the simulation and for compiling. [restart]
#
# This is NOT how much the game uses - it is how much it is allowed to use
# before it starts collecting in earnest. And that is the trap: with a high
# ceiling Java lets memory climb all the way up and leaves it there, because
# collecting costs nothing while there is room to spare. If the ceiling is
# higher than the machine can take, it leans on it, the system starts using the
# disk as memory, and the cycle crawls along with the process still alive -
# which is what happened with 6G on a 7.7G WSL.
#
# Rule: at most HALF of the WSL's memory (check it with "free -h"). What is left
# goes to the database, to the web site (which is another Java), and to the rest
# of the machine.
#
#   WSL with 7.7G  ->  4G here
#   WSL with 11G   ->  6G here
#
# If a week ever fails with OutOfMemory it shows up in the log with those words
# - then the ceiling really is too low, and the thing to lighten is the engine,
# not the memory.
AIRLINE_SBT_HEAP=4G

# Which driver talks to the database. [both]
#
#   mariadb   MariaDB's own, and the match for the server setup.sh installs.
#             Maintained, and faster on the big batches the simulation writes.
#   mysql5    Oracle's old driver from 2020. The game shipped with this.
#
# Both are installed, so switching is this line plus a restart - no rebuild.
# If anything at all looks wrong with the database, put mysql5 back and
# restart; nothing else has to change.
AIRLINE_DB_DRIVER=mariadb


# ============================================================================
#  NOT YET ADJUSTABLE
# ============================================================================
#
# Still hardcoded in the game's source. Ask and they become settings here:
#
#   Passenger demand levels
#     airline-data/src/main/scala/com/patson/DemandGenerator.scala
#
#   Aircraft prices and depreciation
#     airline-data/src/main/scala/com/patson/model/Airplane.scala
#
#   Airport slot counts and landing fees
#     airline-data/src/main/scala/com/patson/model/Airport.scala
#
#   Staff costs and office rent
#     airline-data/src/main/scala/com/patson/model/AirlineBase.scala
